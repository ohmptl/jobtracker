NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Used by the MCP server to access your job rows.
SUPABASE_SERVICE_ROLE_KEY=

# Your one Supabase Auth user UUID.
MCP_USER_ID=

# A random secret with at least 32 characters. It becomes part of the private MCP URL.
MCP_SECRET=

# Server-only. Optional; enables AI parsing in the browser extension.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
