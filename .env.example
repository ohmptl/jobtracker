NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Temporary legacy bridge and scheduled verification only.
SUPABASE_SERVICE_ROLE_KEY=

# Your one Supabase Auth user UUID.
MCP_USER_ID=

# A random secret with at least 32 characters. It becomes part of the private MCP URL.
MCP_SECRET=

# Server-only. Optional; enables AI parsing in the browser extension.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
APP_URL=https://your-jobtracker.example
MCP_OAUTH_ENABLED=false
MCP_ALLOWED_ORIGINS=
MCP_LEGACY_ENABLED=true
# Set an explicit short deadline once the first real OAuth connection is validated.
MCP_LEGACY_DISABLE_AFTER=
# Comma-separated exact extension/site origins; never reflect arbitrary origins.
EXTENSION_ALLOWED_ORIGINS=
CRON_SECRET=
# Exact trusted employer/ATS hostnames only; no wildcards. Empty disables network checks.
VERIFICATION_ALLOWED_HOSTS=
