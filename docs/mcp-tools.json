    {
      "name": "list_jobs",
      "description": "Page through jobs with server filters. Follow next_cursor while has_more. Includes Deleted when no status filter is given.",
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "list": {
            "type": "string",
            "enum": [
              "all",
              "jobs_found",
              "jobs_snoozed",
              "jobs_deleted",
              "to_apply",
              "applied",
              "interviewing",
              "offered",
              "rejected",
              "accepted"
            ]
          },
          "statuses": {
            "minItems": 1,
            "maxItems": 9,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "jobs_found",
                "jobs_snoozed",
                "jobs_deleted",
                "to_apply",
                "applied",
                "interviewing",
                "offered",
                "rejected",
                "accepted"
              ]
            }
          },
          "page_size": {
            "default": 50,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "sort": {
            "default": "date",
            "type": "string",
            "enum": [
              "date",
              "company",
              "position"
            ]
          },
          "cursor": {
            "type": "object",
            "properties": {
              "added_date": {
                "type": "string",
                "format": "date-time",
