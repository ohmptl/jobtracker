              },
              "sort_value": {
                "type": "string",
                "maxLength": 300
              }
            },
            "required": [
              "added_date",
              "id"
            ]
          },
          "company": {
            "type": "string",
            "maxLength": 200
          },
          "title": {
            "type": "string",
            "maxLength": 300
          },
          "q": {
            "type": "string",
            "maxLength": 300
          },
          "location": {
            "type": "string",
            "maxLength": 300
          },
          "role_type": {
            "type": "string",
            "enum": [
              "internship",
              "co_op",
              "full_time",
              "new_grad",
              "other"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "strategic",
              "relevant_full_time",
              "review",
              "low",
              "expired",
              "ineligible"
            ]
          },
          "availability": {
            "type": "string",
            "enum": [
              "open",
              "closed",
              "uncertain",
              "not_checked"
            ]
          },
          "source": {
            "type": "string",
            "maxLength": 200
